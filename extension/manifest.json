{
  "manifest_version": 3,
  "name": "PromptIQ",
  "version": "1.0.0",
  "description": "Better prompts, automatically.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://*.copilot.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://*.copilot.com/*"
      ],
      "js": [
        "content/jszip.min.js",
        "content/adapters/index.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/gemini.js",
        "content/adapters/perplexity.js",
        "content/adapters/copilot.js",
        "content/chatDom.js",
        "content/chatLog.js",
        "content/exporter.js",
        "content/editor.js",
        "content/ui.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}